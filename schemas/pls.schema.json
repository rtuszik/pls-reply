{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/rtuszik/pls-reply/main/schemas/pls.schema.json",
    "title": "pls-reply configuration",
    "description": "Configuration for the pls-reply command-line application.",
    "type": "object",
    "additionalProperties": false,
    "required": ["model", "prompt"],
    "properties": {
        "model": {
            "$ref": "#/$defs/model"
        },
        "fallback": {
            "description": "Models tried in order when the primary model fails before any output.",
            "type": "array",
            "items": {
                "$ref": "#/$defs/model"
            }
        },
        "params": {
            "description": "Optional model-generation parameters.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "temperature": {
                    "description": "Sampling temperature. Some reasoning models accept only their default.",
                    "type": "number"
                },
                "max_tokens": {
                    "description": "Maximum number of output tokens.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "reasoning_effort": {
                    "description": "Provider-dependent reasoning effort hint.",
                    "type": "string",
                    "enum": [
                        "none",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max",
                        "minimal"
                    ]
                }
            }
        },
        "output": {
            "description": "Output and diagnostics settings.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "copy": {
                    "description": "Copy the answer to the system clipboard.",
                    "type": "boolean",
                    "default": true
                },
                "stats": {
                    "description": "Print latency and token statistics to standard error.",
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "commit": {
            "description": "Settings for the commit command.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "scan": {
                    "description": "Secret scan of the staged diff before it is sent to the model.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "description": "Run the scanner by default. The --scan and --no-scan flags override this per run.",
                            "type": "boolean",
                            "default": false
                        },
                        "command": {
                            "description": "Scanner program and arguments. The staged diff is written to its standard input.",
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string"
                            },
                            "default": [
                                "betterleaks",
                                "stdin",
                                "--no-banner",
                                "--no-color",
                                "--redact",
                                "--exit-code",
                                "42"
                            ]
                        },
                        "leak_exit_code": {
                            "description": "Scanner exit code that means secrets were found. Any other non-zero exit code is an error.",
                            "type": "integer",
                            "default": 42
                        }
                    }
                }
            }
        },
        "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system"],
            "properties": {
                "system": {
                    "description": "System prompt for the ask command. The {os} placeholder is replaced with darwin or linux at runtime.",
                    "type": "string"
                },
                "commit": {
                    "description": "System prompt for generating a commit message from staged changes. Uses the built-in Conventional Commit prompt when omitted.",
                    "type": "string"
                }
            }
        }
    },
    "$defs": {
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "name"],
            "properties": {
                "provider": {
                    "description": "LLM provider adapter.",
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "description": "Model name understood by the selected provider.",
                    "type": "string",
                    "minLength": 1
                },
                "base_url": {
                    "description": "OpenAI-compatible endpoint for custom providers, or an override for a built-in provider.",
                    "type": "string"
                },
                "api_key_env": {
                    "description": "Environment variable from which to read the API key.",
                    "type": "string"
                },
                "api_key": {
                    "description": "Literal API key. Takes precedence over api_key_env and is stored as plaintext.",
                    "type": "string"
                }
            },
            "if": {
                "properties": {
                    "provider": { "const": "custom" }
                },
                "required": ["provider"]
            },
            "then": {
                "required": ["base_url"],
                "properties": {
                    "base_url": { "minLength": 1 }
                }
            }
        }
    }
}
